{
  "opencollection": "1.0.0",
  "info": {
    "name": "ActiveCampaign SMS Broadcast Accounts Credits API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Api-Token",
      "value": "{{Api-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ActiveCampaign Get Current Sms Credit Use Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{yourAccountName}.api-us1.com/api/3/sms/credits"
          },
          "docs": "Retrieve the current period's sms credit usage and remaining balance"
        }
      ]
    }
  ],
  "bundled": true
}